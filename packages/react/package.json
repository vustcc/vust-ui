{
  "name": "@vustcc/react",
  "version": "0.1.0-alpha.2",
  "description": "VUST React 19 UI Component Library",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "dist/style.css"
  ],
  "scripts": {
    "build": "vite build",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint"
  },
  "dependencies": {
    "@vustcc/icons": "workspace:*",
    "@vustcc/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vustcc/vust-ui.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2"
  }
}
